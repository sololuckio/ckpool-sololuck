@@ -425,6 +437,8 @@ retry:
 			goto out;
 		}
 	}
+	if (answered)
+		*answered = true;
 	LOGWARNING("BLOCK ACCEPTED! (%s:%s)", cs->url, cs->port);
 	ret = true;
 out:
@@ -432,6 +446,11 @@ out:
 	return ret;
 }
 
+bool submit_block_timeout(connsock_t *cs, const char *params, float timeout, int attempts)
+{
+	return submit_block_answered(cs, params, timeout, attempts, NULL);
+}
