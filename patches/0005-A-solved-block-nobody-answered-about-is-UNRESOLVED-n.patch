+struct block_retry {
+	char *blockhex;
+	char hexpath[PATH_MAX];
+	int height;
+};
+
+typedef struct block_retry block_retry_t;
+
+/* Upstream's "Resubmitting indefinitely!", moved off the caller's thread. Runs
+ * only when the first round produced NO verdict from any node -- i.e. the block
+ * is unresolved, not rejected. Backs off 5s -> 60s and stops the moment any
+ * node accepts it or names a reason for refusing it. */
+static void *block_retry_thread(void *arg)
+{
+	block_retry_t *br = arg;
+	bool answered, ok = false;
+	int delay = SUBMIT_RETRY_MIN_MS, rounds = 0;
+	bool rejected = false;
+	tv_t start, now;
+
+	pthread_detach(pthread_self());
+	rename_proc("bretry");
+	tv_time(&start);
+
+	while (42) {
+		tv_time(&now);
+		if (tvdiff(&now, &start) >= SUBMIT_RETRY_MAX_S)
+			break;
+		cksleep_ms(delay);
+		delay *= 2;
+		if (delay > SUBMIT_RETRY_MAX_MS)
+			delay = SUBMIT_RETRY_MAX_MS;
+		rounds++;
+		answered = false;
+		ok = block_submit_round(br->blockhex, &answered);
+		tv_time(&now);
+		if (ok) {
+			LOGWARNING("BLOCK %d ACCEPTED LATE: background resubmit round %d succeeded "
+				   "%.0fs after the solve. The block was never rejected.",
+				   br->height, rounds, tvdiff(&now, &start));
+			break;
+		}
+		if (answered) {
+			rejected = true;
+			LOGWARNING("Block %d REJECTED by a bitcoind on background resubmit round %d, "
+				   "%.0fs after the solve", br->height, rounds, tvdiff(&now, &start));
+			break;
+		}
+		LOGWARNING("Block %d still UNRESOLVED after background resubmit round %d (%.0fs); "
+			   "no bitcoind has answered. Retrying in %ds.",
+			   br->height, rounds, tvdiff(&now, &start), delay / 1000);
+	}
+	if (!ok && !rejected)
+		LOGWARNING("Block %d GAVE UP after %d s of background resubmits and is still "
+			   "UNRESOLVED. Replay it by hand: bitcoin-cli submitblock \"$(cat %s)\"",
+			   br->height, SUBMIT_RETRY_MAX_S, br->hexpath);
+	free(br->blockhex);
+	free(br);
+	return NULL;
+}
+
+/* height is only used for the log lines; pass 0 if it is not to hand.
+ * *unresolved is set when NO bitcoind returned a verdict: the caller must not
+ * record that as a rejection, because nobody looked at the block. */
+bool generator_submitblock_ex(const char *buf, int height, bool *unresolved)
+{
+	char hexpath[PATH_MAX] = {};
+	bool answered = false, ret;
+	block_retry_t *br;
+	pthread_t pth;
+	FILE *hf;
+
+	if (unresolved)
+		*unresolved = false;
+
+	/* SoloLuck: persist the raw block before submitting so a failed submit
+	 * can be replayed by hand: bitcoin-cli submitblock "$(cat <file>)" */
+	snprintf(hexpath, sizeof(hexpath), "%s/submitblock-%ld.hex", ckpool.logdir, (long)time(NULL));
+	hf = fopen(hexpath, "we");
+	if (hf) {
+		fputs(buf, hf);
+		fputc('\n', hf);
+		fclose(hf);
+		LOGWARNING("Block hex saved to %s for manual resubmit", hexpath);
+	} else
+		LOGWARNING("Failed to save block hex to %s", hexpath);
+	LOGNOTICE("Submitting block data!");
+
+	ret = block_submit_round(buf, &answered);
+	if (ret || answered)
+		return ret;
+
+	/* No node accepted it and no node named a reason for refusing it. That is
+	 * not a rejection -- nobody looked. Keep trying in the background. */
+	if (unresolved)
+		*unresolved = true;
+	LOGWARNING("Block %d UNRESOLVED: no bitcoind returned a verdict. This is NOT a "
+		   "rejection; resubmitting in the background for up to %d s.",
+		   height, SUBMIT_RETRY_MAX_S);
+	br = ckzalloc(sizeof(block_retry_t));
+	br->blockhex = strdup(buf);
+	br->height = height;
+	snprintf(br->hexpath, sizeof(br->hexpath), "%s", hexpath);
+	create_pthread(&pth, block_retry_thread, br);
+	return false;
+}
+
+bool generator_submitblock(const char *buf)
+{
+	return generator_submitblock_ex(buf, 0, NULL);
+}
