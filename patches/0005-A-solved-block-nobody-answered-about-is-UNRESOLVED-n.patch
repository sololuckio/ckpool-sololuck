 	bool ret = false;
 	char *rpc_req;
 
+	if (answered)
+		*answered = false;
 	len = strlen(params) + 64;
 retry:
 	rpc_req = ckalloc(len);
@@ -417,6 +426,9 @@ retry:
 		res_ret = yyjson_get_str(res_val);
 		if (res_ret && strlen(res_ret)) {
 			LOGWARNING("SUBMIT BLOCK RETURNED: %s (%s:%s)", res_ret, cs->url, cs->port);
