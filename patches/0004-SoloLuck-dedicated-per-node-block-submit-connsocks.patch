+/* SoloLuck: preciousblock with a bounded wait, used on the block submit
+ * connsock of every bitcoind that accepted the block. */
+void precious_block_timeout(connsock_t *cs, const char *params, float timeout)
+{
+	yyjson_doc *doc;
+	char *rpc_req;
+	int len;
+
+	if (unlikely(!cs->alive)) {
+		LOGDEBUG("Failed to precious_block due to connsock dead");
+		return;
+	}
+
+	len = strlen(params) + 64;
+	rpc_req = ckalloc(len);
+	sprintf(rpc_req, "{\"method\": \"preciousblock\", \"params\": [\"%s\"]}\n", params);
+	doc = yyjson_rpc_call_timeout(cs, rpc_req, timeout);
+	dealloc(rpc_req);
+	if (doc)
+		LOGNOTICE("preciousblock %s sent to %s:%s", params, cs->url, cs->port);
+	else
+		LOGWARNING("preciousblock %s got no response from %s:%s", params, cs->url, cs->port);
+	yyjson_doc_free(doc);
+}
