+/* SoloLuck 2026-09-03: a solved block must never wait on the template
+ * connection. The old path pushed submitblock through the current server's
+ * connsock (serialised on cs->sem with getblocktemplate, RPC_TIMEOUT 60 s,
+ * 5 attempts) and only then tried the other bitcoinds one after another, so a
+ * hung primary (TCP open, never answers) could sit on a solved block for
+ * minutes. Now every configured bitcoind gets its own throw-away connsock
+ * (own socket, own semaphore) in its own thread, each submitblock attempt is
+ * bounded to SUBMIT_RPC_TIMEOUT seconds and SUBMIT_RPC_ATTEMPTS attempts,
+ * preciousblock goes to every node that accepted, and the caller returns as
+ * soon as any node has accepted (or every node has given up). */
+static const char __attribute__((used)) sololuck_submit_marker[] = "SoloLuck-submit-fanout-20260903";
+
+#define SUBMIT_RPC_TIMEOUT 8	/* seconds to wait for a submitblock/preciousblock answer, per attempt */
+#define SUBMIT_RPC_ATTEMPTS 3	/* attempts per bitcoind: ~24 s on a hung node, then it is given up on */
+/* Hard upper bound on how long the caller (the stratifier) can block. Each
+ * thread is already bounded by connect (5 s) + SUBMIT_RPC_TIMEOUT per attempt. */
+#define SUBMIT_WAIT_MAX_MS ((5 + SUBMIT_RPC_TIMEOUT) * SUBMIT_RPC_ATTEMPTS * 1000 + 5000)
+
+struct block_submit {
+	mutex_t lock;
+	pthread_cond_t cond;
+	char *blockhex;		/* raw block hex, read only once the threads start */
+	char blockhash[68];	/* display order hash of the header, for preciousblock */
+	tv_t start;
+	int servers;		/* threads spawned */
+	int finished;		/* threads done */
+	int accepted;		/* nodes that accepted (bitcoin.c counts "duplicate" as accepted) */
+	int refs;		/* threads + the caller; the last one out frees */
+};
+
+typedef struct block_submit block_submit_t;
+
+struct block_submit_server {
+	block_submit_t *bs;
+	char *url;
+	char *port;
+	char *auth;
+};
+
+typedef struct block_submit_server block_submit_server_t;
+
+static void block_submit_put(block_submit_t *bs)
+{
+	bool last;
+
+	mutex_lock(&bs->lock);
+	last = !--bs->refs;
+	mutex_unlock(&bs->lock);
+	if (!last)
+		return;
+	pthread_cond_destroy(&bs->cond);
+	pthread_mutex_destroy(&bs->lock.mutex);
+	free(bs->blockhex);
+	free(bs);
+}
+
+/* One thread per configured bitcoind: submit the block on a private connsock
+ * that shares nothing with the getblocktemplate connection, then mark it
+ * precious on the nodes that accepted it. */
+static void *block_submit_thread(void *arg)
+{
+	block_submit_server_t *bss = arg;
+	block_submit_t *bs = bss->bs;
+	connsock_t cs;
+	double elapsed;
+	tv_t now;
+	bool ok;
+
+	pthread_detach(pthread_self());
+	rename_proc("bsubmit");
+
+	memset(&cs, 0, sizeof(cs));
+	cs.fd = -1;
+	cs.url = bss->url;
+	cs.port = bss->port;
+	cs.auth = bss->auth;
+	cs.alive = true;
+	cksem_init(&cs.sem);
+	cksem_post(&cs.sem);
+
+	LOGWARNING("Submitting block to %s:%s", cs.url, cs.port);
+	ok = submit_block_timeout(&cs, bs->blockhex, SUBMIT_RPC_TIMEOUT, SUBMIT_RPC_ATTEMPTS);
+	tv_time(&now);
+	elapsed = tvdiff(&now, &bs->start);
+	if (ok) {
+		LOGWARNING("Block accepted by %s:%s after %.3fs", cs.url, cs.port, elapsed);
+		if (bs->blockhash[0])
+			precious_block_timeout(&cs, bs->blockhash, SUBMIT_RPC_TIMEOUT);
+	} else
+		LOGWARNING("Block NOT accepted by %s:%s after %.3fs", cs.url, cs.port, elapsed);
+	cksem_destroy(&cs.sem);
+
+	mutex_lock(&bs->lock);
+	bs->finished++;
+	if (ok)
+		bs->accepted++;
+	pthread_cond_broadcast(&bs->cond);
+	mutex_unlock(&bs->lock);
+
+	free(bss->url);
+	free(bss->port);
+	free(bss->auth);
+	free(bss);
+	block_submit_put(bs);
+	return NULL;
+}
