 			continue;
-		LOGWARNING("Also submitting block to %s:%s", osi->cs.url, osi->cs.port);
-		if (submit_block(&osi->cs, buf))
-			ret = true;
+		if (!extract_sockaddr(si->url, &url, &port)) {
+			LOGWARNING("Failed to extract address from %s for block submit", si->url);
+			continue;
+		}
+		userpass = strdup(si->auth);
+		realloc_strcat(&userpass, ":");
+		realloc_strcat(&userpass, si->pass);
+		bss = ckzalloc(sizeof(block_submit_server_t));
+		bss->auth = http_base64(userpass);
+		dealloc(userpass);
+		if (!bss->auth) {
+			LOGWARNING("Failed to create base64 auth for %s for block submit", si->url);
+			free(url);
+			free(port);
+			free(bss);
+			continue;
