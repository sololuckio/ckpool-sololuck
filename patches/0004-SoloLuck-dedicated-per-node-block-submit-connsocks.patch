+	/* Return as soon as one node accepts, or once every node has given up;
+	 * slower threads carry on in the background and log their own outcome. */
+	tv_time(&now);
+	tv_to_ts(&deadline, &now);
+	ms_to_ts(&wait, SUBMIT_WAIT_MAX_MS);
+	timeraddspec(&deadline, &wait);
+	mutex_lock(&bs->lock);
+	while (!bs->accepted && bs->finished < bs->servers) {
+		if (cond_timedwait(&bs->cond, &bs->lock, &deadline) == ETIMEDOUT)
+			break;
+	}
+	ret = bs->accepted > 0;
+	tv_time(&now);
+	elapsed = tvdiff(&now, &bs->start);
+	LOGWARNING("Block %s: %d of %d bitcoinds accepted, %d failed, %d still trying, %.3fs after solve",
+		   ret ? "SUBMITTED" : "NOT ACCEPTED", bs->accepted, bs->servers,
+		   bs->finished - bs->accepted, bs->servers - bs->finished, elapsed);
+	mutex_unlock(&bs->lock);
+	block_submit_put(bs);
 	return ret;
 }
 
