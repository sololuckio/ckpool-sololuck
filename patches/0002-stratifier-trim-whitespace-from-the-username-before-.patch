From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SoloLuck ops <releases@sololuck.io>
Date: Fri, 28 Aug 2026 02:40:41 +0000
Subject: [PATCH 2/5] stratifier: trim whitespace from the username before
 address validation

bitcoind validateaddress trims a stray leading/trailing space and reports
the address valid; our own base58 decoder does not, so address_to_txn built
the coinbase payout script from the untrimmed string and would have paid a
block to a script that is not the miner address - silently wrong rather than
rejected. Only legacy base58 addresses are affected; bech32 fails bitcoind
validation outright.

Trim before both get_create_user() and address_to_txn() in generate_user()
and generate_remote_user(), so the two validators agree and " addr"/"addr"
collapse to one account instead of two.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/stratifier.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/stratifier.c b/src/stratifier.c
index d1313ca9..df40040b 100644
--- a/src/stratifier.c
+++ b/src/stratifier.c
@@ -5752,6 +5752,29 @@ static worker_instance_t *get_worker(sdata_t *sdata, user_instance_t *user, cons
 	return get_create_worker(sdata, user, workername, &dummy);
 }
 
+/* Miners commonly paste a payout address with stray surrounding whitespace.
+ * bitcoind's validateaddress trims it and reports the address valid, but our own
+ * base58 decoder does not, so the coinbase would be built from the untrimmed
+ * string and pay to a script that is NOT the miner's address - silently wrong
+ * rather than rejected. Trim before both the user lookup and address_to_txn so
+ * the two validators agree, and so " addr" and "addr" collapse to one account
+ * instead of two. */
+static char *trim_username(char *username)
+{
+	char *end;
+
+	if (!username)
+		return username;
+	while (*username == ' ' || *username == '\t' || *username == '\r' ||
+	       *username == '\n')
+		username++;
+	end = username + strlen(username);
+	while (end > username && (end[-1] == ' ' || end[-1] == '\t' ||
+				  end[-1] == '\r' || end[-1] == '\n'))
+		*(--end) = '\0';
+	return username;
+}
+
 /* This simply strips off the first part of the workername and matches it to a
  * user or creates a new one. Needs to be entered with client holding a ref
  * count. */
@@ -5768,6 +5791,7 @@ static user_instance_t *generate_user(stratum_instance_t *client,
 	username = strsep(&base_username, "._");
 	if (!username || !strlen(username))
 		username = base_username;
+	username = trim_username(username);
 	len = strlen(username);
 	if (unlikely(len > 127))
 		username[127] = '\0';
@@ -7338,6 +7362,7 @@ static user_instance_t *generate_remote_user(const char *workername)
 	username = strsep(&base_username, "._");
 	if (!username || !strlen(username))
 		username = base_username;
+	username = trim_username(username);
 	len = strlen(username);
 	if (unlikely(len > 127))
 		username[127] = '\0';
