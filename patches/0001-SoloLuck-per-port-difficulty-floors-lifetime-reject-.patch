+/* Optional per-server difficulty array, index-aligned to serverurl. Each
+ * positive entry sets the starting/floor (vardiff minimum) difficulty for
+ * connections on that server binding. A zero (or missing/short) entry leaves
+ * that server on the default behaviour (vardiff from startdiff, or highdiff
+ * for high port servers). Must be parsed after parse_serverurls so that
+ * ckpool.serverdiff is already allocated. */
+static void parse_serverdiffs(yyjson_val *arr_val)
+{
+	int arr_size, i;
+
+	if (!arr_val)
+		return;
+	if (!yyjson_is_arr(arr_val)) {
+		LOGWARNING("Unable to parse serverdiff entries as an array");
+		return;
+	}
+	if (!ckpool.serverdiff) {
+		LOGWARNING("serverdiff specified but no serverurl array allocated");
+		return;
+	}
+	arr_size = yyjson_arr_size(arr_val);
+	for (i = 0; i < arr_size && i < ckpool.serverurls; i++) {
+		yyjson_val *val = yyjson_arr_get(arr_val, i);
+
+		if (!val || !yyjson_is_int(val)) {
+			LOGWARNING("Invalid serverdiff entry number %d, leaving default", i);
+			continue;
+		}
+		ckpool.serverdiff[i] = yyjson_get_sint(val);
+		LOGNOTICE("Server %d (%s) serverdiff floor set to %"PRId64, i,
+			  ckpool.serverurl[i] ? ckpool.serverurl[i] : "?", ckpool.serverdiff[i]);
+	}
+	if (arr_size != ckpool.serverurls)
+		LOGWARNING("serverdiff array size %d does not match serverurl count %d",
+			   arr_size, ckpool.serverurls);
+}
+
 static void parse_nodeservers(yyjson_val *arr_val)
 {
