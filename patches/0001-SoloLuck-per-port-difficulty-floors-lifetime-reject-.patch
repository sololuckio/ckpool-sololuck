+	arr_val = yyjson_obj_get(json_conf, "serverdiff");
+	parse_serverdiffs(arr_val);
 	arr_val = yyjson_obj_get(json_conf, "nodeserver");
 	parse_nodeservers(arr_val);
 	arr_val = yyjson_obj_get(json_conf, "trusted");
